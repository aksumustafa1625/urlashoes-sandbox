<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <description>KPI cards and Top-N Opportunity progress list driven by Score__c and Completed_Task__c.</description>
    <masterLabel>Opportunity Task Progress</masterLabel>
    <targets>
        <target>lightning__HomePage</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__HomePage,lightning__AppPage,lightning__RecordPage">
            <property name="title" type="String" label="Card Title" default="Task Progress" />
            <property name="topN" type="Integer" label="Top N Opportunities" default="10" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
