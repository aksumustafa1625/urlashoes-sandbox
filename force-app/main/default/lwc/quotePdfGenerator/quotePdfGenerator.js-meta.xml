<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <description>Generates a styled Quote PDF client-side using jsPDF and attaches it to the Quote with version control. Auto-runs on first page load when no PDF exists.</description>
    <masterLabel>Quote PDF Generator</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Quote</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
